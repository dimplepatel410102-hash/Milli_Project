# Copy to sdkconfig.secrets (git-ignored) and fill in. Values here are PLACEHOLDERS.
# They seed a NEW sdkconfig only: after the first build, change values with
# `idf.py menuconfig`, or delete sdkconfig and rebuild to re-apply this file.

CONFIG_MILLI_WIFI_SSID="your-wifi-ssid"
CONFIG_MILLI_WIFI_PASSWORD="your-wifi-password"

# Your PC's LAN IP while the backend runs with --host 0.0.0.0
CONFIG_MILLI_SERVER_URL="http://192.168.x.y:8000"
CONFIG_MILLI_DEVICE_ID="dev-cam-01"
CONFIG_MILLI_DEVICE_API_KEY="paste-key-from-app.tools.device_key"

# Camera pins: copy from your board's schematic/vendor docs. -1 = not connected.
# Leave CONFIG_MILLI_CAM_PINS_VERIFIED unset until every pin has been checked.
# CONFIG_MILLI_CAM_PINS_VERIFIED=y
CONFIG_MILLI_CAM_PIN_PWDN=-1
CONFIG_MILLI_CAM_PIN_RESET=-1
CONFIG_MILLI_CAM_PIN_XCLK=-1
CONFIG_MILLI_CAM_PIN_SIOD=-1
CONFIG_MILLI_CAM_PIN_SIOC=-1
CONFIG_MILLI_CAM_PIN_D0=-1
CONFIG_MILLI_CAM_PIN_D1=-1
CONFIG_MILLI_CAM_PIN_D2=-1
CONFIG_MILLI_CAM_PIN_D3=-1
CONFIG_MILLI_CAM_PIN_D4=-1
CONFIG_MILLI_CAM_PIN_D5=-1
CONFIG_MILLI_CAM_PIN_D6=-1
CONFIG_MILLI_CAM_PIN_D7=-1
CONFIG_MILLI_CAM_PIN_VSYNC=-1
CONFIG_MILLI_CAM_PIN_HREF=-1
CONFIG_MILLI_CAM_PIN_PCLK=-1
