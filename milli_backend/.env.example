# Copy to .env for local development:  Copy-Item .env.example .env
# Never commit .env. Production must use a secret manager, not a file.

# development | test | production
MILLI_ENVIRONMENT=development
MILLI_LOG_LEVEL=INFO
# Set to false in production to hide /docs, /redoc and /openapi.json
MILLI_ENABLE_DOCS=true

# Comma-separated "device_id:sha256_hex_of_api_key" entries. Placeholder below is NOT a real key.
# Generate a real entry (and the device's API key) with:
#   .\.venv\Scripts\python.exe -m app.tools.device_key new lobby-cam-01 --env-file .env
MILLI_DEVICE_CREDENTIALS=
# Example format:
# MILLI_DEVICE_CREDENTIALS=lobby-cam-01:<64-hex-sha256>,door-cam-02:<64-hex-sha256>

# If true, a device must call /api/v1/devices/register before /api/v1/camera/capture.
# Registrations are in memory in Phase 1, so devices must re-register after a server restart.
MILLI_REQUIRE_REGISTRATION=false

# Upload limits
MILLI_MAX_IMAGE_BYTES=5242880
MILLI_MAX_IMAGE_PIXELS=25000000
# Any of: JPEG, PNG, BMP, WEBP, GIF, TIFF (detected from bytes, not Content-Type)
MILLI_ALLOWED_IMAGE_FORMATS=JPEG,PNG,BMP,WEBP

# Server-side face detection: none | opencv_haar | opencv_yunet (needs requirements-detection.txt;
# opencv_yunet also needs the models: .\.venv\Scripts\python.exe scripts\download_models.py)
MILLI_FACE_DETECTOR=none
# Minimum YuNet detection confidence (0..1)
MILLI_FACE_MIN_CONFIDENCE=0.6

# Server-side face recognition (OpenCV YuNet + SFace). Always detects with YuNet when enabled.
MILLI_FACE_RECOGNITION=false
# Minimum cosine similarity for a match; below it the face is "Unknown". 0.363 is the SFace default.
MILLI_FACE_MATCH_THRESHOLD=0.363
MILLI_FACE_MODEL_DIR=models
# Enrolled face embeddings (biometric data: keep private, never commit)
MILLI_FACE_DB_PATH=data/faces.json

# Temporary image storage (off by default; images are processed in memory and discarded)
MILLI_STORE_IMAGES=false
MILLI_STORAGE_DIR=data/captures
# Delete stored images older than this many seconds (0 = keep until deleted manually)
MILLI_STORAGE_MAX_AGE_SECONDS=3600
