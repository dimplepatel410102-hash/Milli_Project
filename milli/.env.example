# Milli Face Detection Backend — development configuration
# Copy this file to .env and replace the placeholder API key.
# Never commit .env. The placeholder key is rejected on purpose.

MILLI_APP_NAME=Milli Face Detection Backend
MILLI_VERSION=0.1.0
MILLI_ENV=development
MILLI_LOG_LEVEL=INFO

# Used by: python -m app.main
# Keep the host on localhost until you intentionally expose it to the ESP32 on your LAN.
MILLI_HOST=127.0.0.1
MILLI_PORT=8000

# Maximum accepted image size in bytes (1 MiB). The HTTP body limit is this plus 8 KiB.
MILLI_MAX_IMAGE_BYTES=1048576

# Images stay in memory for the request. Set true only for local debugging.
MILLI_STORE_IMAGES=false
# When storage is enabled, the temp file is deleted after the request unless this is true.
MILLI_RETAIN_TEMP_IMAGES=false
# Optional directory for temporary images. Empty uses the system temp directory /milli.
MILLI_TEMP_DIR=

# Comma-separated device_id:api_key pairs. The split is on the first colon.
# Device IDs: letters, digits, dot, underscore, hyphen; 1-64 characters; no spaces.
# API keys: at least 16 characters, no spaces or commas. Do not use the placeholder.
# Example with two devices:
# MILLI_DEVICE_CREDENTIALS=dev-device-001:put-a-long-random-key-here,dev-device-002:put-another-long-random-key-here
MILLI_DEVICE_CREDENTIALS=dev-device-001:replace-with-a-long-random-key

# Phase 1 runs only "disabled": the image is accepted and no detector runs.
# "server" and "device" are reserved. Selecting them returns HTTP 501 and no face result.
MILLI_FACE_DETECTION_MODE=disabled
